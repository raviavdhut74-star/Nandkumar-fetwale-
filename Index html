    <p>शाही फेटे, पुणेरी पगडी, मावळा पगडी आणि बरंच काही...</p>
    <a href="#products" class="btn">उत्पादने पहा</a>
  </section>

  <!-- Products Section -->
  <section class="products-section" id="products">
    <h2 class="section-title">आमची उत्पादने</h2>
    <div class="product-grid" id="productGrid">
      <!-- उत्पादने JavaScript द्वारे आपोआप येथे लोड होतील -->
    </div>
  </section>

  <!-- Contact Section -->
  <footer class="footer">
    <h3>संपर्क व पत्ता</h3>
    <p><i class="fas fa-map-marker-alt"></i> आमचे दुकान: मुख्य बाजारपेठ</p>
    <p><i class="fas fa-phone"></i> मोबाईल: +91 98XXXXXXXX</p>
    <div class="social-links">
      <a href="https://wa.me/9198XXXXXXXX" target="_blank" class="whatsapp-btn">
        <i class="fab fa-whatsapp"></i> थेट WhatsApp वर संपर्क साधा
      </a>
    </div>
    <p class="copyright">© 2024 नंदकुमार फेटेवाले. सर्व हक्क राखीव.</p>
  </footer>

  <script src="script.js"></script>
