<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>नंदकुमार फेटेवाले - पारंपारिक फेटे व पगडी</title>
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>

  <!-- Header -->
  <header class="header">
    <div class="logo">
      <h1>नंदकुमार फेटेवाले</h1>
      <p>भव्य व राजेशाही फेट्यांचे विश्वासू ठिकाण</p>
